# Version control
# .git is intentionally NOT excluded: the builder stage runs `git archive
# HEAD` to select exactly the committed source tree, discarding anything
# untracked regardless of name (Phase 16 - untracked alembic autogenerate
# artifacts were previously baked into every wheel built from this repo).
# It is only ever read inside the discarded builder stage, never copied
# into the final runtime image.
.gitignore

# Python artifacts
__pycache__
*.pyc
*.pyo
*.egg-info
dist
build
*.egg

# Testing artifacts
.coverage
coverage.xml
htmlcov
.pytest_cache
.mypy_cache
.ruff_cache

# Database files
*.db
*.sqlite
*.sqlite3

# Environment and secrets
.env
.env.*
!.env.example

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Frontend (not needed in Docker build)
frontend/node_modules
frontend/dist
frontend/.vite

# Documentation
docs
*.md
!README.md

# Docker
docker-compose*.yml
.dockerignore

# Stale artifacts
prototypes
kingsec.db
