# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Bundled frontend build output, copied into the package by the release
# pipeline (see release.yml, Dockerfile) - never hand-authored, never committed.
src/kingsec/adapters/inbound/web/static/

# Environment & secrets (NEVER commit real values)
.env
.env.*
!.env.example

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Scratch / transient output files
*_out.txt
*_err.txt

# Development environment snapshots
clean-env/

# Local runtime data (KingSec local store, generated reports, logs)
/data/
*.sqlite
*.sqlite3
*.db
/reports/
*.log

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
