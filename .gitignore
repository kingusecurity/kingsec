# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Bundled frontend build output, copied into the package by the release
# pipeline (see release.yml, Dockerfile) - never hand-authored, never committed.
src/kingsec/adapters/inbound/web/static/

# Environment & secrets (NEVER commit real values)
.env
.env.*
!.env.example

# License signing private key (holder-only; never shipped with the app,
# never committed). See tools/issue_license.py and keys/README.md.
keys/*.pem
!keys/README.md

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.npm-cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Scratch / transient output files
*_out.txt
*_err.txt

# Local Docker build artifacts (never intended for version control - an
# untracked ~112MB `kingsec-image.tar` export and a `docker-build-log.txt`
# capture were both found sitting in the repo during Phase 33's worktree
# audit; neither is a build input or generated-by-CI artifact, just local
# scratch output from manual `docker save`/`docker build > log` commands)
*.tar
docker-build-log.txt

# Development environment snapshots
clean-env/

# Local runtime data (KingSec local store, generated reports, logs)
/data/
*.sqlite
*.sqlite3
*.db
/reports/
*.log

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
