# KingSec Frontend — Environment Variables
# These are embedded at build time. Prefix with VITE_ to expose to client code.

# API base path (path-prefix, not a full URL)
# In production, the API is served from the same origin via reverse proxy.
# Default: /api/v1
VITE_API_BASE_URL=/api/v1

# Backend URL (informational only — used by Vite dev server proxy)
# Default: http://127.0.0.1:8000
VITE_BACKEND_URL=http://127.0.0.1:8000
