# KingSec configuration template.
#
# Copy this file to `.env` and adjust values for your machine:
#     cp .env.example .env            (Linux/macOS)
#     copy .env.example .env           (Windows)
#
# `.env` is for LOCAL DEVELOPMENT convenience only. It must be listed in
# .gitignore and must never contain a real production secret. In production,
# supply values through the environment or a secret store.
#
# Convention: KINGSEC_<GROUP>__<FIELD>   (double underscore separates group/field)
# Lines shown with a value are defaults; uncomment only what you need to change.
#
# LEGEND:
#   ⚠️  MUST CONFIGURE — required for production use; change the default value
#   🔧 OPTIONAL      — has a safe default; adjust as needed
#   ℹ️  INFO          — informational; must match deployment

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED (must configure for production)
# ═══════════════════════════════════════════════════════════════════════════════

# ⚠️  JWT signing secret — GENERATE A NEW RANDOM SECRET for every deployment.
#     Minimum 64 characters. Use:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#     REQUIRED — the server refuses to start with ConfigError if this is left
#     at its placeholder default, in every environment including local
#     development (Phase 25). Production additionally enforces a 32-byte
#     minimum length.
# KINGSEC_JWT__SECRET_KEY=orj185NNlImFCif-b3rtivk0sbgnQzKE_09PygZb2sv7nR97sbC8Z9NQNI6KXKSReUeNJniD1MyAg3UvhDBs0w

# ⚠️  API key pepper — GENERATE A NEW RANDOM VALUE for every deployment.
#     Used to hash API keys. Should be unique per installation.
#     REQUIRED — the server refuses to start with ConfigError if this is left
#     at its placeholder default, in every environment including local
#     development (Phase 25). Production additionally enforces a 32-byte
#     minimum length.
# KINGSEC_SECRETS__API_KEY_PEPPER=yAO45beMuW_Yu5blcY0ux8K4Vw-JF4MuZuMtabVf1KHCr3hysGLpORAZKwAYqLhY07tE0P038OV-1rl5V3J8Pg

# ⚠️  Encryption key — base64url-encoded 32-byte Fernet key for secrets at rest.
#     Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#     REQUIRED — the server refuses to start with ConfigError if this is
#     unset, in every environment including local development. There is no
#     disabled mode; a real generated key is always needed.
# KINGSEC_SECRETS__ENCRYPTION_KEY=ypDKsg4SVECQujZCWP1Z5_r6YC5h7ZU5TGeDOu2byF4=

# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 Runtime environment. Controls error verbosity and behavior.
#     Also gates the production-only secret checks (placeholder rejection,
#     minimum length) in Settings - see KINGSEC_JWT__SECRET_KEY /
#     KINGSEC_SECRETS__API_KEY_PEPPER above.
#     Phase 27: the provided docker-compose.yml is a production deployment
#     file and hardcodes KINGSEC_APP__ENVIRONMENT=production in its own
#     `environment:` block, which always overrides whatever this line is set
#     to here (Docker Compose's `environment:` wins over `env_file:` for the
#     same key) - setting this to development/testing here has NO effect
#     when running via `docker compose up`. It only takes effect for a bare
#     `python -m kingsec` / `kingsec` run outside Docker.
# KINGSEC_APP__ENVIRONMENT=development      # development | testing | production

# 🔧 Debug mode. MUST be false in production (exposes stack traces).
# KINGSEC_APP__DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 Listen address. Loopback by default — safe for local-only access.
# KINGSEC_SERVER__HOST=127.0.0.1

# 🔧 Listen port.
# KINGSEC_SERVER__PORT=8765

# ⚠️  Set true ONLY if running on an authorized network behind a reverse proxy.
#     Binding to 0.0.0.0 without this flag raises a startup error.
# KINGSEC_SERVER__ALLOW_EXTERNAL_BIND=false

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 Authorization gate. When enabled, all scanning APIs require authentication.
# KINGSEC_SECURITY__REQUIRE_AUTHORIZATION=true

# ═══════════════════════════════════════════════════════════════════════════════
# JWT (token authentication)
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 Signing algorithm. Only HS256 is supported.
# KINGSEC_JWT__ALGORITHM=HS256
# KINGSEC_JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
# KINGSEC_JWT__REFRESH_TOKEN_EXPIRE_DAYS=7
# KINGSEC_JWT__ISSUER=kingsec

# ═══════════════════════════════════════════════════════════════════════════════
# AI — Bring Your Own Key (all features work without AI)
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 AI provider configuration. Skip this section entirely if not using AI.
# KINGSEC_AI__PROVIDER=anthropic
# KINGSEC_AI__BASE_URL=                     # optional; must be http(s):// if set
# KINGSEC_AI__API_KEY=                      # your key; leave blank to configure later
# KINGSEC_AI__MODEL=claude-sonnet-4-5
# KINGSEC_AI__REQUEST_TIMEOUT_SECONDS=30
# KINGSEC_AI__TEMPERATURE=0.2
# KINGSEC_AI__MAX_TOKENS=1024
# KINGSEC_AI__RETRY_COUNT=2
# KINGSEC_AI__RETRY_DELAY=0.5
# KINGSEC_AI__VERIFY_SSL=true

# ═══════════════════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 Log level and format.
# KINGSEC_LOGGING__LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
# KINGSEC_LOGGING__JSON_FORMAT=false        # true for structured JSON logs

# ═══════════════════════════════════════════════════════════════════════════════
# STORAGE (database)
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 Data directory. The running application always uses a SQLite database
#     at <DATA_DIR>/kingsec.db - this is the only database URL the server
#     itself honours.
# KINGSEC_STORAGE__DATA_DIR=~/.kingsec

# ⚠️  Phase 26: KINGSEC_STORAGE__DATABASE_URL is NOT a Settings field and is
#     NOT read by the running application (`python -m kingsec`) - setting it
#     makes the server refuse to start with a ConfigError ("Extra inputs are
#     not permitted"). It is read only by the Alembic migration CLI
#     (kingsec-migrate / `alembic upgrade head`, via env.py), as an override
#     for pointing migrations at an external database independently of the
#     server's own SQLite storage. Do not set this expecting it to change
#     what database the running server connects to - use
#     KINGSEC_STORAGE__DATA_DIR for that. See also ALEMBIC_DATABASE_URL below.
# KINGSEC_STORAGE__DATABASE_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# SCANNERS
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 Each scanner section controls binary path and timeout.
#     Set binary_path to the name or full path of the executable.

# --- Nuclei ---
# KINGSEC_SCANNER__BINARY_PATH=nuclei
# KINGSEC_SCANNER__TEMPLATES_DIR=
# KINGSEC_SCANNER__TIMEOUT_SECONDS=300
# KINGSEC_SCANNER__RATE_LIMIT=150

# --- Nmap ---
# KINGSEC_NMAP__BINARY_PATH=nmap
# KINGSEC_NMAP__TIMEOUT_SECONDS=600

# --- Nikto ---
# KINGSEC_NIKTO__BINARY_PATH=nikto
# KINGSEC_NIKTO__TIMEOUT_SECONDS=600

# --- Trivy ---
# KINGSEC_TRIVY__BINARY_PATH=trivy
# KINGSEC_TRIVY__TIMEOUT_SECONDS=600
# KINGSEC_TRIVY__SCAN_TYPE=fs              # fs | image

# --- OWASP ZAP ---
# KINGSEC_ZAP__BINARY_PATH=zap
# KINGSEC_ZAP__TIMEOUT_SECONDS=1200

# --- Semgrep ---
# KINGSEC_SEMGREP__BINARY_PATH=semgrep
# KINGSEC_SEMGREP__TIMEOUT_SECONDS=600

# --- Amass ---
# KINGSEC_AMASS__BINARY_PATH=amass
# KINGSEC_AMASS__TIMEOUT_SECONDS=900

# --- Gobuster ---
# KINGSEC_GOBUSTER__BINARY_PATH=gobuster
# KINGSEC_GOBUSTER__TIMEOUT_SECONDS=600

# --- ffuf ---
# KINGSEC_FFUF__BINARY_PATH=ffuf
# KINGSEC_FFUF__TIMEOUT_SECONDS=600

# ═══════════════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 API rate limiting configuration.
# KINGSEC_RATE_LIMIT__ENABLED=true
# KINGSEC_RATE_LIMIT__API_REQUESTS_PER_MINUTE=120
# KINGSEC_RATE_LIMIT__AUTH_REQUESTS_PER_MINUTE=20
# KINGSEC_RATE_LIMIT__BURST_SIZE=30

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY HEADERS
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 HTTP security headers sent with every response.
# KINGSEC_SECURITY_HEADERS__X_CONTENT_TYPE_OPTIONS=nosniff
# KINGSEC_SECURITY_HEADERS__X_FRAME_OPTIONS=DENY
# KINGSEC_SECURITY_HEADERS__CONTENT_SECURITY_POLICY=default-src 'none'
# KINGSEC_SECURITY_HEADERS__REMOVE_SERVER_HEADER=true
# KINGSEC_SECURITY_HEADERS__REMOVE_X_POWERED_BY=true

# ═══════════════════════════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 Cross-Origin Resource Sharing settings (for frontend access).
# KINGSEC_CORS__ALLOW_ORIGINS=[]            # comma-separated list of origins
# KINGSEC_CORS__ALLOW_CREDENTIALS=false
# KINGSEC_CORS__MAX_AGE=600

# ═══════════════════════════════════════════════════════════════════════════════
# MIDDLEWARE
# ═══════════════════════════════════════════════════════════════════════════════

# 🔧 HTTP middleware settings.
# KINGSEC_MIDDLEWARE__GZIP_ENABLED=true
# KINGSEC_MIDDLEWARE__GZIP_MINIMUM_SIZE=500
# KINGSEC_MIDDLEWARE__REQUEST_LOGGING=true

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE MIGRATION (Alembic override)
# ═══════════════════════════════════════════════════════════════════════════════

# ℹ️  Only needed to override the database URL for Alembic migrations.
#     By default migrates use the same database as the running application.
# ALEMBIC_DATABASE_URL=
