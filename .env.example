# =============================================================================
# KingSec - Environment Configuration TEMPLATE
# -----------------------------------------------------------------------------
# Copy to `.env` (which is git-ignored) and fill in values for your machine.
# This template documents WHICH settings exist and their intent - it contains
# NO secrets and must never contain any. Real values live only in your local
# `.env` and are never committed.
#
# All variables are namespaced with the KINGSEC_ prefix so they are unambiguous
# in a shared shell and easy to load with pydantic-settings.
# =============================================================================

# --- Application -------------------------------------------------------------
KINGSEC_ENV=                    # development | production
KINGSEC_LOG_LEVEL=              # DEBUG | INFO | WARNING | ERROR   (default: INFO)
KINGSEC_LOG_FORMAT=             # console | json                   (default: console in dev)

# --- Local web server --------------------------------------------------------
# Local-first: bind to loopback by default. Do NOT expose to 0.0.0.0 unless you
# fully understand the exposure - this is a security tool holding sensitive data.
KINGSEC_HOST=                   # default: 127.0.0.1
KINGSEC_PORT=                   # default: 8000

# --- Persistence (local) -----------------------------------------------------
KINGSEC_DATA_DIR=               # directory for local data (created if missing)
KINGSEC_DB_PATH=                # path to the local database file (under DATA_DIR)

# --- AI provider (BRING YOUR OWN KEY) ----------------------------------------
# The key is supplied by the user, used only on this machine, and never leaves
# it. It is read from the local .env and must never be committed.
KINGSEC_AI_PROVIDER=            # adapter selector, e.g. anthropic | openai
KINGSEC_AI_API_KEY=             # USER-SUPPLIED SECRET - leave blank here
KINGSEC_AI_MODEL=               # provider model identifier
KINGSEC_AI_BASE_URL=            # optional: override for self-hosted / proxy endpoints
KINGSEC_AI_TIMEOUT_SECONDS=     # default: 60

# --- Async jobs --------------------------------------------------------------
KINGSEC_JOB_WORKERS=            # background job concurrency
KINGSEC_JOB_TIMEOUT_SECONDS=    # per-job hard ceiling

# --- Reporting ---------------------------------------------------------------
KINGSEC_REPORT_OUTPUT_DIR=      # where generated PDF reports are written

# --- Safety / authorization gate ---------------------------------------------
# Non-negotiable guardrail: active scanning is blocked until authorization is
# confirmed. This defaults to ON and should stay ON.
KINGSEC_REQUIRE_AUTHORIZATION=  # true | false                     (default: true)
