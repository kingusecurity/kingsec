# KingSec configuration template.
#
# Copy this file to `.env` and adjust values for your machine:
#     cp .env.example .env
#
# `.env` is for LOCAL DEVELOPMENT and CI convenience only. It must be listed in
# .gitignore and must never contain a real production secret. In production,
# supply values through the environment or a secret store (keyring integration
# is planned — see the config module README).
#
# Convention: KINGSEC_<GROUP>__<FIELD>   (double underscore separates group/field)
# Every line below shows the DEFAULT; uncomment only what you need to change.

# --- App ---------------------------------------------------------------------
# KINGSEC_APP__ENVIRONMENT=development      # development | testing | production
# KINGSEC_APP__DEBUG=false                  # must be false in production

# --- Server (security guardrail lives here) ----------------------------------
# KINGSEC_SERVER__HOST=127.0.0.1            # loopback by default; do not expose casually
# KINGSEC_SERVER__PORT=8765
# KINGSEC_SERVER__ALLOW_EXTERNAL_BIND=false # set true ONLY on an authorized network

# --- Security ----------------------------------------------------------------
# KINGSEC_SECURITY__REQUIRE_AUTHORIZATION=true  # the authorization gate; keep enabled

# --- JWT (MUST override secret_key in production) ----------------------------
# KINGSEC_JWT__SECRET_KEY=CHANGE-ME-IN-PRODUCTION-DO-NOT-USE-DEFAULT
# KINGSEC_JWT__ALGORITHM=HS256
# KINGSEC_JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
# KINGSEC_JWT__REFRESH_TOKEN_EXPIRE_DAYS=7
# KINGSEC_JWT__ISSUER=kingsec

# --- AI (Bring-Your-Own-Key) -------------------------------------------------
# KINGSEC_AI__PROVIDER=anthropic
# KINGSEC_AI__BASE_URL=                     # optional; must be http(s):// if set
# KINGSEC_AI__API_KEY=                      # your key; leave blank to configure later
# KINGSEC_AI__MODEL=claude-sonnet-4-5
# KINGSEC_AI__REQUEST_TIMEOUT_SECONDS=30
# KINGSEC_AI__TEMPERATURE=0.2
# KINGSEC_AI__MAX_TOKENS=1024
# KINGSEC_AI__RETRY_COUNT=2
# KINGSEC_AI__RETRY_DELAY=0.5
# KINGSEC_AI__VERIFY_SSL=true

# --- Logging (consumed by Module 2.2) ----------------------------------------
# KINGSEC_LOGGING__LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
# KINGSEC_LOGGING__JSON_FORMAT=false        # true for structured JSON logs in prod

# --- Storage -----------------------------------------------------------------
# KINGSEC_STORAGE__DATA_DIR=~/.kingsec

# --- Scanner (Nuclei — Module 5.1) -------------------------------------------
# KINGSEC_SCANNER__BINARY_PATH=nuclei       # path/name of the Nuclei binary
# KINGSEC_SCANNER__TEMPLATES_DIR=           # templates dir (blank = Nuclei default)
# KINGSEC_SCANNER__TIMEOUT_SECONDS=300      # hard wall-clock scan timeout
# KINGSEC_SCANNER__RATE_LIMIT=150           # requests/sec cap (-rl)

# --- Scanner (Nmap — Module 5.3) ---------------------------------------------
# KINGSEC_NMAP__BINARY_PATH=nmap
# KINGSEC_NMAP__TIMEOUT_SECONDS=600

# --- Scanner (Nikto — Module 5.4) --------------------------------------------
# KINGSEC_NIKTO__BINARY_PATH=nikto
# KINGSEC_NIKTO__TIMEOUT_SECONDS=600

# --- Scanner (Trivy — Module 5.5) --------------------------------------------
# KINGSEC_TRIVY__BINARY_PATH=trivy
# KINGSEC_TRIVY__TIMEOUT_SECONDS=600
# KINGSEC_TRIVY__SCAN_TYPE=fs              # fs | image

# --- Scanner (ZAP — Module 5.6) ----------------------------------------------
# KINGSEC_ZAP__BINARY_PATH=zap
# KINGSEC_ZAP__TIMEOUT_SECONDS=1200

# --- Scanner (Semgrep — Module 5.7) ------------------------------------------
# KINGSEC_SEMGREP__BINARY_PATH=semgrep
# KINGSEC_SEMGREP__TIMEOUT_SECONDS=600

# --- Scanner (Amass — Module 5.8) --------------------------------------------
# KINGSEC_AMASS__BINARY_PATH=amass
# KINGSEC_AMASS__TIMEOUT_SECONDS=900

# --- Scanner (Gobuster — Module 5.9) -----------------------------------------
# KINGSEC_GOBUSTER__BINARY_PATH=gobuster
# KINGSEC_GOBUSTER__TIMEOUT_SECONDS=600

# --- Scanner (ffuf — Module 5.10) --------------------------------------------
# KINGSEC_FFUF__BINARY_PATH=ffuf
# KINGSEC_FFUF__TIMEOUT_SECONDS=600

# --- Rate Limiting -----------------------------------------------------------
# KINGSEC_RATE_LIMIT__ENABLED=true
# KINGSEC_RATE_LIMIT__API_REQUESTS_PER_MINUTE=120
# KINGSEC_RATE_LIMIT__AUTH_REQUESTS_PER_MINUTE=20
# KINGSEC_RATE_LIMIT__BURST_SIZE=30

# --- Security Headers --------------------------------------------------------
# KINGSEC_SECURITY_HEADERS__X_CONTENT_TYPE_OPTIONS=nosniff
# KINGSEC_SECURITY_HEADERS__X_FRAME_OPTIONS=DENY
# KINGSEC_SECURITY_HEADERS__CONTENT_SECURITY_POLICY=default-src 'none'
# KINGSEC_SECURITY_HEADERS__REMOVE_SERVER_HEADER=true
# KINGSEC_SECURITY_HEADERS__REMOVE_X_POWERED_BY=true

# --- CORS --------------------------------------------------------------------
# KINGSEC_CORS__ALLOW_ORIGINS=[]            # comma-separated list of origins
# KINGSEC_CORS__ALLOW_CREDENTIALS=false
# KINGSEC_CORS__MAX_AGE=600

# --- Secrets (MUST override in production) -----------------------------------
# KINGSEC_SECRETS__API_KEY_PEPPER=CHANGE-ME-IN-PRODUCTION-DO-NOT-USE-DEFAULT
# KINGSEC_SECRETS__ENCRYPTION_KEY=          # base64url-encoded 32-byte Fernet key

# --- Middleware --------------------------------------------------------------
# KINGSEC_MIDDLEWARE__GZIP_ENABLED=true
# KINGSEC_MIDDLEWARE__GZIP_MINIMUM_SIZE=500
# KINGSEC_MIDDLEWARE__REQUEST_LOGGING=true
